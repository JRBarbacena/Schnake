{
  "name": "whos-the-snake-king",
  "version": "1.0.0",
  "private": true,
  "description": "Who's the Snake King - A premium slither.io-style browser game",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/src/main.ts",
    "dev:client": "vite client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:shared": "npm run build -w shared",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf shared/dist server/dist client/dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "fast-check": "^3.19.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
